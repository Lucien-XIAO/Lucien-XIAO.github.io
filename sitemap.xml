---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign public_pages = site.pages | sort: "url" %}
  {% for item in public_pages %}
  {% if item.layout and item.url != "/404.html" %}
  {% unless item.noindex %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ item.url | replace: "index.html", "" | xml_escape }}</loc>
  </url>
  {% endunless %}
  {% endif %}
  {% endfor %}
</urlset>
